################################################################################
# .gitignore para solución .NET / Visual Studio
################################################################################

# Carpetas de build
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Resultados de pruebas / cobertura
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage*.json
coverage*.xml
coverage*.info

# Paquetes NuGet restaurados
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Rider / VS Code
.idea/
.vscode/

# Superpowers
.superpowers/

# Secretos locales (nunca commitear credenciales reales)
appsettings.*.Local.json
deploy/.env
