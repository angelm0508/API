# Copiá este archivo a ".env" (en la misma carpeta) y completá valores reales.
# ".env" está en .gitignore - nunca se commitea.

# Contraseña del usuario sa de SQL Server dentro del contenedor. Usar una fuerte
# (mayúsculas, minúsculas, número y símbolo) - SQL Server la rechaza si es débil.
DB_SA_PASSWORD=CambiaEsto123!

# Clave de firma de los JWT que emite la API. Distinta a la de desarrollo,
# minimo 20 caracteres.
JWT_KEY=CambiaEstaClavePorUnaLargaYUnica2026

# Estos dos pueden quedar iguales a appsettings.json si no necesitás cambiarlos.
JWT_ISSUER=TuAplicacion
JWT_AUDIENCE=TuAplicacionUsuarios
